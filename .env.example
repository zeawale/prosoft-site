DATABASE_URL=file:./prosoft-site.db
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Публичный адрес сайта: metadataBase, sitemap, robots, сведение доменов.
# На проде канонический адрес, без слэша в конце
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Номер счётчика Яндекс.Метрики, только на проде. Пусто — Метрики на сайте нет.
# Подставляется при сборке: поменяли — пересобрать
NEXT_PUBLIC_YM_ID=

# Письма о заявках. Без SMTP_HOST письма пишутся в консоль, наружу ничего не уходит.
# Яндекс: smtp.yandex.ru, порт 465, логин — ящик целиком, пароль — пароль приложения
# (id.yandex.ru → Безопасность → Пароли приложений → Почта), не пароль от ящика
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Кому слать заявки. Пусто — письма не отправляются
LEADS_NOTIFY_TO=
